+/*
+Copyright 2026 Mosaix contributors.
+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+import { describe, expect, it, vi } from "vitest";
+import type { BrowserWindow } from "electron";
+
+import { isPopoutRequest, onScreenBounds, registerPopout, setPopoutAlwaysOnTop } from "./popouts.js";
+
+const primary = { x: 0, y: 0, width: 1920, height: 1040 };
+const right = { x: 1920, y: 0, width: 2560, height: 1400 };
+const screen = {
+    getAllDisplays: () => [{ workArea: primary }, { workArea: right }],
+    getPrimaryDisplay: () => ({ workArea: primary }),
+};
+
+function fakeWindow(bounds = { x: 4000, y: 20, width: 480, height: 270 }) {
+    const handlers: Record<string, () => void> = {};
+    const win = {
+        setMenuBarVisibility: vi.fn(),
+        getBounds: () => bounds,
+        setBounds: vi.fn(),
+        setAlwaysOnTop: vi.fn(),
+        isDestroyed: () => false,
+        on: vi.fn((ev: string, cb: () => void) => {
+            handlers[ev] = cb;
+        }),
+        webContents: { on: vi.fn(), setWindowOpenHandler: vi.fn() },
+        handlers,
+    };
+    return win;
+}
+
+describe("pop-outs", () => {
+    it("only accepts empty windows named like a pop-out", () => {
+        expect(isPopoutRequest({ url: "about:blank", frameName: "mosaix-popout-abc_1-ff" })).toBe(true);
+        expect(isPopoutRequest({ url: "about:blank#x", frameName: "mosaix-popout-abc" })).toBe(false);
+        expect(isPopoutRequest({ url: "vector://vector/webapp/", frameName: "mosaix-popout-abc" })).toBe(false);
+        expect(isPopoutRequest({ url: "about:blank", frameName: "mosaix-popout-" })).toBe(false);
+        expect(isPopoutRequest({ url: "about:blank", frameName: "mosaix-popout-a b" })).toBe(false);
+        expect(isPopoutRequest({ url: "about:blank", frameName: "_blank" })).toBe(false);
+    });
+
+    it("keeps a pop-out where it was if that is on a screen", () => {
+        const onRight = { x: 4000, y: 20, width: 480, height: 270 };
+        expect(onScreenBounds(onRight, [primary, right], primary)).toBe(onRight);
+    });
+
+    it("moves a pop-out of a missing monitor onto the primary screen", () => {
+        const gone = { x: -2500, y: 100, width: 480, height: 270 };
+        expect(onScreenBounds(gone, [primary], primary)).toEqual({ x: 720, y: 385, width: 480, height: 270 });
+        // Barely visible counts as gone, and it is shrunk to fit
+        expect(onScreenBounds({ x: 1900, y: 0, width: 5000, height: 2000 }, [primary], primary)).toEqual(primary);
+    });
+
+    it("keeps a pop-out on top on request, also when asked before it exists", () => {
+        setPopoutAlwaysOnTop("mosaix-popout-early", true);
+        const early = fakeWindow();
+        registerPopout(early as unknown as BrowserWindow, "mosaix-popout-early", screen);
+        expect(early.setAlwaysOnTop).toHaveBeenCalledWith(true, "screen-saver");
+
+        const win = fakeWindow({ x: -3000, y: 0, width: 480, height: 270 });
+        registerPopout(win as unknown as BrowserWindow, "mosaix-popout-later", screen);
+        expect(win.setBounds).toHaveBeenCalledWith({ x: 720, y: 385, width: 480, height: 270 });
+        expect(win.setAlwaysOnTop).not.toHaveBeenCalled();
+        setPopoutAlwaysOnTop("mosaix-popout-later", true);
+        setPopoutAlwaysOnTop("mosaix-popout-later", false);
+        expect(win.setAlwaysOnTop.mock.calls).toEqual([
+            [true, "screen-saver"],
+            [false, "screen-saver"],
+        ]);
+        // Nonsense from the renderer is ignored
+        setPopoutAlwaysOnTop("other-window", true);
+        setPopoutAlwaysOnTop("mosaix-popout-later", "yes");
+        expect(win.setAlwaysOnTop).toHaveBeenCalledTimes(2);
+    });
+
+    it("lets a pop-out neither navigate nor open windows, and forgets it when closed", () => {
+        const win = fakeWindow();
+        registerPopout(win as unknown as BrowserWindow, "mosaix-popout-gone", screen);
+        expect(win.setMenuBarVisibility).toHaveBeenCalledWith(false);
+        const [event, onNavigate] = win.webContents.on.mock.calls[0];
+        expect(event).toBe("will-navigate");
+        const navigation = { preventDefault: vi.fn() };
+        onNavigate(navigation);
+        expect(navigation.preventDefault).toHaveBeenCalled();
+        expect(win.webContents.setWindowOpenHandler.mock.calls[0][0]()).toEqual({ action: "deny" });
+        win.handlers.closed();
+        setPopoutAlwaysOnTop("mosaix-popout-gone", true);
+        expect(win.setAlwaysOnTop).not.toHaveBeenCalled();
+    });
+});
