+++ b/apps/desktop/src/popouts.ts
@@ -0,0 +1,106 @@
+/*
+Copyright 2026 Mosaix contributors.
+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+// [mosaix] Pop-outs: Element Call shows a camera or screen share in a window
+// of its own (`window.open("", "mosaix-popout-…")`, filled by Element Call
+// itself). Only such empty windows with that name are allowed; they cannot
+// navigate or open further windows. On request they stay on top of all other
+// windows (also over games in windowed or borderless mode).
+
+import type { BrowserWindow, BrowserWindowConstructorOptions, Rectangle } from "electron";
+
+const POPOUT_NAME = /^mosaix-popout-[A-Za-z0-9_-]{1,80}$/;
+
+/** How much of a pop-out must be on a screen; otherwise it is moved back. */
+const MIN_VISIBLE = 48;
+
+export const POPOUT_WINDOW_OPTIONS: BrowserWindowConstructorOptions = {
+    autoHideMenuBar: true,
+    backgroundColor: "#000000",
+    minWidth: 160,
+    minHeight: 90,
+    webPreferences: {
+        // Keep playing while another window (a game) covers it
+        backgroundThrottling: false,
+    },
+};
+
+/** Whether a `window.open` request is one of Element Call's pop-outs. */
+export function isPopoutRequest(details: { url: string; frameName: string }): boolean {
+    return details.url === "about:blank" && POPOUT_NAME.test(details.frameName);
+}
+
+const windows = new Map<string, BrowserWindow>();
+/** Requested before the window existed, or for later windows of that name. */
+const wantedOnTop = new Map<string, boolean>();
+
+function applyOnTop(win: BrowserWindow, onTop: boolean): void {
+    // "screen-saver" is the highest level: above full-screen windows too
+    win.setAlwaysOnTop(onTop, "screen-saver");
+}
+
+/** Keeps a pop-out on top of all other windows, or not. */
+export function setPopoutAlwaysOnTop(name: unknown, onTop: unknown): void {
+    if (typeof name !== "string" || !POPOUT_NAME.test(name) || typeof onTop !== "boolean") return;
+    wantedOnTop.set(name, onTop);
+    const win = windows.get(name);
+    if (win && !win.isDestroyed()) applyOnTop(win, onTop);
+}
+
+function visibleArea(a: Rectangle, b: Rectangle): { width: number; height: number } {
+    return {
+        width: Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x),
+        height: Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y),
+    };
+}
+
+/**
+ * The bounds of a pop-out, moved onto the primary screen if it would not be
+ * visible (e.g. its remembered monitor is gone).
+ */
+export function onScreenBounds(bounds: Rectangle, workAreas: Rectangle[], primary: Rectangle): Rectangle {
+    const visible = workAreas.some((area) => {
+        const { width, height } = visibleArea(bounds, area);
+        return width >= MIN_VISIBLE && height >= MIN_VISIBLE;
+    });
+    if (visible) return bounds;
+    const width = Math.min(bounds.width, primary.width);
+    const height = Math.min(bounds.height, primary.height);
+    return {
+        x: Math.round(primary.x + (primary.width - width) / 2),
+        y: Math.round(primary.y + (primary.height - height) / 2),
+        width,
+        height,
+    };
+}
+
+interface Screen {
+    getAllDisplays(): { workArea: Rectangle }[];
+    getPrimaryDisplay(): { workArea: Rectangle };
+}
+
+/** Sets up a pop-out window that Electron just created. */
+export function registerPopout(win: BrowserWindow, name: string, screen: Screen): void {
+    windows.set(name, win);
+    win.setMenuBarVisibility(false);
+    const bounds = win.getBounds();
+    const fixed = onScreenBounds(
+        bounds,
+        screen.getAllDisplays().map((d) => d.workArea),
+        screen.getPrimaryDisplay().workArea,
+    );
+    if (fixed !== bounds) win.setBounds(fixed);
+    const onTop = wantedOnTop.get(name);
+    if (onTop !== undefined) applyOnTop(win, onTop);
+
+    // Element Call fills the window; it never shows anything else
+    win.webContents.on("will-navigate", (event) => event.preventDefault());
+    win.webContents.setWindowOpenHandler(() => ({ action: "deny" }));
+    win.on("closed", () => {
+        if (windows.get(name) === win) windows.delete(name);
+    });
+}
