+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+import { describe, expect, it, vi } from "vitest";
+import type * as Electron from "electron";
+import type { Streams, WebFrameMain } from "electron";
+
+import { type AppAudio, withScreenShareAudio } from "./screenShareAudio.js";
+
+const window440 = { video: { id: "window:11:0", name: "Player" } } as Streams;
+const screen = { video: { id: "screen:0:0", name: "Entire screen" } } as Streams;
+const playerFrame = { name: "player" } as unknown as WebFrameMain;
+
+function appAudio(supported = true, frame: WebFrameMain | null = playerFrame): AppAudio {
+    return { isSupported: () => supported, start: vi.fn().mockResolvedValue(frame), stop: vi.fn() };
+}
+
+const options = (overrides: object = {}) => ({
+    audioRequested: true,
+    platform: "win32" as NodeJS.Platform,
+    electron: {} as typeof Electron,
+    ownPid: 1000,
+    requestFrame: null,
+    ...overrides,
+});
+
+describe("withScreenShareAudio", () => {
+    it("adds the captured sound of the chosen source", async () => {
+        const module = appAudio();
+        expect(await withScreenShareAudio(window440, options({ appAudio: module }))).toEqual({
+            ...window440,
+            audio: playerFrame,
+        });
+        expect(module.start).toHaveBeenCalledWith(
+            expect.objectContaining({ sourceId: "window:11:0", ownPid: 1000 }),
+        );
+        expect(await withScreenShareAudio(screen, options({ appAudio: module }))).toEqual({
+            ...screen,
+            audio: playerFrame,
+        });
+    });
+
+    it("adds no sound when there is nothing to capture (e.g. Mosaix's own window)", async () => {
+        expect(await withScreenShareAudio(window440, options({ appAudio: appAudio(true, null) }))).toEqual(window440);
+    });
+
+    it("falls back to the whole system's sound on older Windows", async () => {
+        expect(await withScreenShareAudio(screen, options({ appAudio: appAudio(false) }))).toEqual({
+            ...screen,
+            audio: "loopback",
+        });
+        expect(await withScreenShareAudio(screen, options({ appAudio: null }))).toEqual({
+            ...screen,
+            audio: "loopback",
+        });
+    });
+
+    it("adds no sound when the call doesn't ask for it, off Windows, or when cancelled", async () => {
+        const module = appAudio();
+        expect(await withScreenShareAudio(screen, options({ appAudio: module, audioRequested: false }))).toEqual(screen);
+        expect(await withScreenShareAudio(screen, options({ appAudio: module, platform: "linux" }))).toEqual(screen);
+        const cancelled = { video: { id: "", name: "" } } as Streams;
+        expect(await withScreenShareAudio(cancelled, options({ appAudio: module }))).toEqual(cancelled);
+        expect(module.start).not.toHaveBeenCalled();
+    });
+});
diff --git a/apps/desktop/src/screenShareAudio.ts b/apps/desktop/src/screenShareAudio.ts
new file mode 100644
index 0000000..c51de55
--- /dev/null
+++ b/apps/desktop/src/screenShareAudio.ts
@@ -0,0 +1,80 @@
+/*
+Copyright 2026 Mosaix contributors.
+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+// [mosaix] Sound for screen sharing on Windows (see desktop/app-audio in the
+// Mosaix repository): sharing a window adds the sound of that application
+// only, sharing a screen adds the system's sound without Mosaix itself, so
+// nobody hears the call twice.
+
+import type * as Electron from "electron";
+import type { Streams, WebFrameMain } from "electron";
+import { createRequire } from "node:module";
+import fs from "node:fs";
+import path from "node:path";
+
+export interface AppAudio {
+    isSupported(): boolean;
+    start(options: {
+        electron: typeof Electron;
+        sourceId: string;
+        ownPid: number;
+        requestFrame: WebFrameMain | null;
+    }): Promise<WebFrameMain | null>;
+    stop(): void;
+}
+
+let appAudio: AppAudio | null = null;
+
+/** Loads the app audio module shipped next to the app, if present. */
+export function initAppAudio(dir: string): void {
+    const entry = path.join(dir, "lib", "index.cjs");
+    if (!fs.existsSync(entry)) return;
+    try {
+        appAudio = createRequire(import.meta.url)(entry) as AppAudio;
+    } catch (e) {
+        console.error("Could not load the app audio module", e);
+    }
+}
+
+/** Ends the sound of the current screen share (the call says when it stops). */
+export function stopScreenShareAudio(): void {
+    appAudio?.stop();
+}
+
+export interface ScreenShareAudioOptions {
+    audioRequested: boolean;
+    platform: NodeJS.Platform;
+    electron: typeof Electron;
+    ownPid: number;
+    requestFrame: WebFrameMain | null;
+    /** For tests */
+    appAudio?: AppAudio | null;
+}
+
+/**
+ * Adds the sound to a chosen screen share source when the call asked for it
+ * (Element Call's "Share audio").
+ */
+export async function withScreenShareAudio(streams: Streams, options: ScreenShareAudioOptions): Promise<Streams> {
+    const audioModule = options.appAudio !== undefined ? options.appAudio : appAudio;
+    const video = streams.video;
+    // A cancelled picker returns a dummy source without an id
+    const sourceId = video !== undefined && "id" in video && typeof video.id === "string" ? video.id : "";
+    if (!options.audioRequested || options.platform !== "win32" || sourceId === "") return streams;
+
+    if (audioModule?.isSupported()) {
+        const audio = await audioModule.start({
+            electron: options.electron,
+            sourceId,
+            ownPid: options.ownPid,
+            requestFrame: options.requestFrame,
+        });
+        return audio ? { ...streams, audio } : streams;
+    }
+    // Windows before 10 2004: only the whole system's sound is possible
+    return { ...streams, audio: "loopback" };
+}
