+/*
+Copyright 2026 Mosaix contributors.
+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+import type { Streams } from "electron";
+
+/**
+ * [mosaix] Adds the system audio to a chosen screen share source when the web
+ * content asked for audio (Element Call does when "Share audio" is on).
+ *
+ * Electron can only capture the whole system's audio ("loopback"), and only on
+ * Windows; there is no way to capture a single application's audio.
+ */
+export function withSystemAudio(streams: Streams, audioRequested: boolean, platform: NodeJS.Platform): Streams {
+    const video = streams.video;
+    // A cancelled picker returns a dummy source without an id
+    const chosen = video !== undefined && "id" in video && typeof video.id === "string" && video.id !== "";
+    if (!audioRequested || platform !== "win32" || !chosen) return streams;
+    return { ...streams, audio: "loopback" };
+}
