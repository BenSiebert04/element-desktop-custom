+
+SPDX-License-Identifier: AGPL-3.0-only
+Please see LICENSE in the repository root for full details.
+*/
+
+import { describe, expect, it } from "vitest";
+import type { Streams } from "electron";
+
+import { withSystemAudio } from "./systemAudio.js";
+
+const screen = { video: { id: "screen:0:0", name: "Entire screen" } } as Streams;
+
+describe("withSystemAudio", () => {
+    it("shares the system audio on Windows when the call asks for audio", () => {
+        expect(withSystemAudio(screen, true, "win32")).toEqual({ ...screen, audio: "loopback" });
+    });
+
+    it("shares no audio when the call doesn't ask for it", () => {
+        expect(withSystemAudio(screen, false, "win32")).toEqual(screen);
+    });
+
+    it("shares no audio where Electron can't capture it", () => {
+        expect(withSystemAudio(screen, true, "linux")).toEqual(screen);
+        expect(withSystemAudio(screen, true, "darwin")).toEqual(screen);
+    });
+
+    it("adds nothing when the picker was cancelled", () => {
+        const cancelled = { video: { id: "", name: "" } } as Streams;
+        expect(withSystemAudio(cancelled, true, "win32")).toEqual(cancelled);
+    });
+});
